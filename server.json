{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.pooriaarab/agentic-canvas",
  "description": "A shared whiteboard for diagrams, drawn by people and agents.",
  "version": "0.9.0",
  "repository": {
