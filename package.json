{
  "name": "agentic-canvas",
  "version": "0.2.0",
  "description": "A shared whiteboard for diagrams, drawn by people and agents.",
  "keywords": [
    "whiteboard",
    "canvas",
    "diagrams",
    "drawing",
    "collaboration",
    "agents",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-canvas.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-canvas",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./live-worker": {
      "types": "./dist/live-worker.d.ts",
      "import": "./dist/live-worker.js"
    },
    "./file-store": {
      "types": "./dist/store-file.d.ts",
      "import": "./dist/store-file.js"
    }
  },
  "bin": {
    "agentic-canvas": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "ci:local": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-identity": "^0.4.0",
    "agentic-realtime": "^0.1.0",
    "yjs": "^13.6.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "hono": "^4.13.14",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.64.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  }
}
