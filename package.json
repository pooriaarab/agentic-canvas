{
  "name": "agentic-canvas",
  "version": "0.13.0",
  "description": "A shared whiteboard for diagrams, drawn by people and agents.",
  "keywords": [
    "whiteboard",
    "canvas",
    "diagrams",
    "drawing",
    "collaboration",
    "agents",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-canvas.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "llms.txt",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-canvas",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "import": "./dist/live.js"
    },
    "./live-worker": {
      "types": "./dist/live-worker.d.ts",
      "import": "./dist/live-worker.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./file-store": {
      "types": "./dist/store-file.d.ts",
      "import": "./dist/store-file.js"
    },
    "./ui": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js"
    },
    "./ui.css": "./dist/ui.css"
  },
  "bin": {
    "agentic-canvas": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && vite build && node ui/build-css.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "dev": "npm run build && WRANGLER_SEND_METRICS=false wrangler dev --port 8793 --var CANVAS_REGION:unknown",
    "dev:smoke": "npm run build && node scripts/dev-smoke.mjs 8793 /health --var CANVAS_REGION:unknown",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e",
    "deploy:demo": "wrangler deploy -c wrangler.demo.jsonc",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-design": "^0.5.0",
    "agentic-identity": "^0.9.0",
    "agentic-realtime": "^0.4.4",
    "yjs": "^13.6.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "hono": "^4.13.14",
    "jsdom": "^26.0.0",
    "miniflare": "^4.20260730.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "zod": "$zod"
  }
}
